<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">

    <title>urlShortener</title>
</head>
<body>
    <div class="container">
    <h1>Digite a url</h1>
    <form action="/shortUrls" method="POST" class="my-4 form-inline">
        <label for="fullURL" class="sr-only">URL</label>
        <input type="url" 
        name="fullUrl" id="fullUrl" placeholder="Insira a url" required class="form-control col mr-2">
        <input type="submit" value="Encolher" class="btn btn-sucess" style="background-color:rgb(0, 128, 4);color:white;">
    </form>

    <table class="table table-striped table-responsive">
        <thead>
        <tr>
            <th>Url completo</th>
            <th>Url encurtado</th>
            <th>Clicks</th>
        </tr>
    </thead>
    
    <tbody>
        <tr>
        <td> <a href="https://aldwansolutions.com">https://aldwansolutions.com</a></td>
        <td><a href="1234567">1234567</a></td>
        <td>10</td>
    </tr>
    </tbody>
</table>
</div>
</body>
</html>